# legacy-archaeologist reads these variables (src/infra/config.ts). Copy to .env (ignored by Git) for a real
# provider; the demo and npm test need none of them. An empty value counts as unset.

# none | fake | openai-compatible. Unset: fake when fixtures/llm/<scenario>.json exists for the target, else none.
LLM_PROVIDER=
# OpenAI-compatible endpoint; the client posts to <base>/chat/completions. Other bases (not verified here):
# OpenAI https://api.openai.com/v1
# Gemini https://generativelanguage.googleapis.com/v1beta/openai
# Ollama http://127.0.0.1:11434/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
# Never echoed; redacted by value in every log line, trace line, error line and artifact.
LLM_API_KEY=
# listed by the public OpenRouter models endpoint on 2026-10-12
LLM_MODEL=openrouter/free
# LLM call timeout, 1000 to 120000.
LLM_TIMEOUT_MS=30000
# Per-step wait for a callback or a promise in the recording child, 100 to 30000.
LA_CASE_TIMEOUT_MS=2000
# The parent's per-case watchdog fires at steps x case timeout + this margin, 100 to 10000.
LA_WATCHDOG_MARGIN_MS=1000
# Mutants per run, truncated in a stable order, 1 to 2000.
LA_MAX_MUTANTS=200
# Survivor rounds, 0 to 3.
LA_MAX_ROUNDS=1
# debug | info | warn | error (logs are JSON lines on stderr).
LOG_LEVEL=info
